const cv=document.getElementById('cv'),ctx=cv.getContext('2d');
const box=document.getElementById('mainBox');
const img=new Image(),off=document.createElement('canvas'),octx=off.getContext('2d');
let marks=[],fitScale=1,selected=-1,inlierIdx=[],lastDx=null,lastDy=null;
const ds=()=>fitScale,bx=()=>(cv.width-img.width*ds())/2,by=()=>(cv.height-img.height*ds())/2;
const toImg=(x,y)=>({u:(x-bx())/ds(),v:(y-by())/ds()});
function fit(){const mw=box.clientWidth,mh=box.clientHeight;
  if(mw<=0||mh<=0){requestAnimationFrame(fit);return;}
  cv.width=mw;cv.height=mh;fitScale=Math.min(mw/img.width,mh/img.height);draw()}
function ring(x,y,r,c,lw){const d=ds(),X=bx()+x*d,Y=by()+y*d;ctx.save();ctx.beginPath();ctx.arc(X,Y,r*d,0,Math.PI*2);ctx.strokeStyle=c;ctx.lineWidth=lw;ctx.shadowColor=c;ctx.shadowBlur=7;ctx.stroke();ctx.restore()}
function dot(x,y,c,s){const d=ds(),X=bx()+x*d,Y=by()+y*d;ctx.save();ctx.fillStyle=c;ctx.beginPath();ctx.arc(X,Y,s,0,Math.PI*2);ctx.shadowColor=c;ctx.shadowBlur=9;ctx.fill();ctx.restore()}
function spinner(on){const el=document.getElementById('spinner');if(el)el.classList.toggle('show',!!on)}
function draw(){if(!cv.width||!img.width)return;ctx.clearRect(0,0,cv.width,cv.height);
  const d=ds();ctx.drawImage(off,bx(),by(),img.width*d,img.height*d);
  marks.forEach((m,i)=>{const sel=i===selected;
    const inl=inlierIdx.includes(i);
    const col=sel?'#ffc400':(inl?'#22c55e':'#ff5d5d');
    ring(m.cx,m.cy,m.r,col,sel?3.5:(inl?2.5:1.6));
    dot(m.cx,m.cy,col,sel?7:(inl?4.5:3));
    ctx.fillStyle='#fff';ctx.font='bold 11px sans-serif';ctx.fillText(String(i+1),bx()+m.cx*d+8,by()+m.cy*d-8)});
}
function hitMarker(u,v){const d=ds();for(let i=marks.length-1;i>=0;i--)
  if(Math.hypot((u-marks[i].cx)*d,(v-marks[i].cy)*d)<62)return i;return -1}
img.onload=()=>{spinner(false);off.width=img.width;off.height=img.height;octx.drawImage(img,0,0);marks=[];selected=-1;inlierIdx=[];fit();setStat('已标 0/4 孔','ok');
  const nm=frameSrc==='stereo'?'双目':'吊舱', want=frameSrc==='stereo'?[1536,1280]:[1280,720];
  const cc=$('curCam'); if(cc) cc.textContent='当前帧：'+nm+' 标定口径 '+want[0]+'×'+want[1]+'，实际 '+img.width+'×'+img.height;
  let h='已取帧（'+nm+'），点「检测圆」或手动点孔标注；dx/dy 用'+nm+'那套常量，两路 mm 1:1';
  if(img.width!==want[0]||img.height!==want[1]) h+=' ⚠️ 帧尺寸与常量口径不符，scale/参考点需按 '+img.width+'×'+img.height+' 重标';
  document.getElementById('hint').textContent=h;
  recompute()};
img.onerror=()=>{spinner(false);document.getElementById('hint').textContent='获取帧失败，检查抓帧服务';setStat('取帧失败','')};
new ResizeObserver(fit).observe(box);
cv.addEventListener('pointerdown',e=>{
  const r=cv.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top,{u,v}=toImg(px,py);
  const hit=hitMarker(u,v);
  if(hit>=0){selected=hit}
  else{const s=snapImageData(octx.getImageData(0,0,off.width,off.height),u,v);
    const cx=s?s.cx:u, cy=s?s.cy:v;
    const dup=marks.find(m=>Math.hypot(m.cx-cx,m.cy-cy)<60);
    if(dup){selected=marks.indexOf(dup)}
    else{marks.push({cx,cy,r:s?s.r:30,snapped:!!s,auto:false});selected=marks.length-1}}
  draw();recompute()});
/* 选中圆后：方向键微调位置 + 放大/缩小圆 */
function nudge(dx,dy){const m=marks[selected];if(!m)return;m.cx+=dx;m.cy+=dy;m.snapped=false;draw();recompute()}
function resize(dr){const m=marks[selected];if(!m)return;m.r=Math.max(10,m.r+dr);draw()}
function holdRepeat(btn,fn,interval=90){let timer=null,rep=null;
  const stop=()=>{clearTimeout(timer);clearInterval(rep);timer=rep=null};
  btn.addEventListener('pointerdown',e=>{e.preventDefault();fn();
    timer=setTimeout(()=>{rep=setInterval(fn,interval)},220)});
  btn.addEventListener('pointerup',stop);btn.addEventListener('pointerleave',stop);
  btn.addEventListener('pointercancel',stop)}
holdRepeat(document.getElementById('mvUp'),()=>nudge(0,-5));
holdRepeat(document.getElementById('mvDown'),()=>nudge(0,5));
holdRepeat(document.getElementById('mvLeft'),()=>nudge(-5,0));
