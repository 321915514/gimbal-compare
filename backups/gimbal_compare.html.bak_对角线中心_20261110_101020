<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0a0f1e">
<title>吊舱↔双目 对比验证</title>
<style>
:root{
  --bg:#0a0f1e; --bg2:#0d1426; --panel:#121a2e; --panel2:#18233c; --border:#22304d;
  --fg:#e8eefb; --muted:#8b98b2; --accent:#4f8cff; --accent2:#7c5cff;
  --ok:#2ecc71; --warn:#f5a623; --danger:#ff5d5d; --real:#5cb3ff;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;background:linear-gradient(160deg,var(--bg),var(--bg2) 70%);
  color:var(--fg);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  overscroll-behavior:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
#app{display:flex;flex-direction:column;height:100%}
header{display:flex;align-items:center;gap:10px;padding:8px 14px;padding-top:calc(8px + env(safe-area-inset-top));
  background:rgba(18,26,46,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);flex:none}
.logo{width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex:none}
header .t{font-size:13px;font-weight:700;letter-spacing:.4px}
header .t small{display:inline;font-size:9px;color:var(--muted);font-weight:400;letter-spacing:.2px;margin-left:7px}
header .sp{flex:1}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);
  background:var(--panel2);border:1px solid var(--border);border-radius:20px;padding:5px 12px}
.pill .dot{width:7px;height:7px;border-radius:50%;background:#4a5870}
.pill.ok .dot{background:var(--ok);box-shadow:0 0 8px var(--ok)}
.pill.busy .dot{background:var(--accent);box-shadow:0 0 8px var(--accent)}
.toolbar{display:flex;gap:8px;padding:8px 14px;flex:none;align-items:center}
button.act{height:38px;padding:0 14px;border-radius:10px;border:1px solid var(--border);background:var(--panel2);
  color:var(--fg);font-size:13px;font-weight:600;cursor:pointer;transition:.14s;white-space:nowrap}
button.act:active{transform:scale(.95)}
button.act.ghost{background:transparent;color:var(--muted)}
button.act.ghost:hover{border-color:var(--accent);color:var(--fg)}
button.act.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;color:#fff;
  box-shadow:0 4px 14px rgba(79,140,255,.35);font-size:14px;padding:0 22px}
button.act.primary:hover{filter:brightness(1.1)}
button.act:disabled{opacity:.45;cursor:not-allowed;transform:none}
.body{flex:1;min-height:0;display:flex;flex-direction:row;overflow:hidden}
.main{flex:1;min-width:0;position:relative;overflow:hidden;background:#05070f;border-right:1px solid var(--border);touch-action:none;margin-bottom:6px}
.main canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;-ms-touch-action:none}
.side{width:235px;min-width:0;overflow:hidden;padding:11px 11px 2px;background:var(--bg2);touch-action:none}
.side .panel{margin:0;height:100%;min-height:0;display:flex;flex-direction:column;padding:6px 12px}
.side details{border:1px solid var(--border);border-radius:12px;background:var(--panel);overflow:hidden}
.side details summary{padding:10px 13px;cursor:pointer;color:var(--muted);font-size:12.5px;font-weight:600;
  list-style:none;user-select:none}
.side details summary::-webkit-details-marker{display:none}
.side details[open] summary{color:var(--fg);border-bottom:1px solid var(--border)}
.side details .panel{margin:0;border:0;border-radius:0;background:transparent;padding:11px 13px}
@media(orientation:portrait),(max-width:560px){.body{flex-direction:column}.side{width:auto;flex:none;overflow:hidden;touch-action:none}}
.hintbar{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);font-size:12px;color:var(--muted);
  background:rgba(5,7,15,.82);padding:6px 15px;border-radius:20px;pointer-events:none;white-space:nowrap;
  border:1px solid var(--border);opacity:0;transition:opacity .35s}
.hintbar.show{opacity:1}
.panel{margin:11px 18px 0;padding:8px 12px;border-radius:14px;background:var(--panel);
  border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,.25);flex:none}
.panel h3{margin:0 0 4px;font-size:11px;color:var(--muted);font-weight:600;letter-spacing:1px;
  text-transform:uppercase;display:flex;align-items:center;gap:7px}
.panel h3::before{content:'';width:3px;height:13px;border-radius:2px;
  background:linear-gradient(180deg,var(--accent),var(--accent2))}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.field{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted)}
.field input{width:76px;height:34px;border-radius:9px;border:1px solid var(--border);background:var(--panel2);
  color:var(--fg);padding:0 8px;font-size:14px;text-align:right;font-family:Consolas,monospace}
.field input:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 2px rgba(79,140,255,.15)}
.field input.big{width:112px}
textarea{width:100%;height:48px;border-radius:10px;border:1px solid var(--border);background:var(--panel2);
  color:var(--fg);padding:9px 11px;font-size:12.5px;font-family:Consolas,monospace;resize:vertical}
textarea:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 2px rgba(79,140,255,.15)}
.cmp{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px;flex:0 0 auto}
.cmp .cell{background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:5px 10px;text-align:left;
  display:flex;flex-direction:column;justify-content:center;
  transition:.15s}
.cmp .cell.real{border-color:rgba(92,179,255,.4);background:rgba(92,179,255,.06)}
.cmp .cell.delta-ok{border-color:rgba(46,204,113,.45);background:rgba(46,204,113,.08)}
.cmp .cell.delta-bad{border-color:rgba(255,93,93,.5);background:rgba(255,93,93,.1)}
.cmp .lbl{font-size:10px;color:var(--muted)}
.cmp .val{font-size:13px;font-weight:700;font-family:Consolas,monospace;margin-top:1px;letter-spacing:-.5px}
.cmp .val small{font-size:11px;font-weight:400;color:var(--muted);margin-left:2px}
.cmp .val.ok{color:var(--ok)} .cmp .val.bad{color:var(--danger)} .cmp .val.real{color:var(--real)}
/* 吊舱与双目 dx/dy 并成一行 4 格；结果区可收缩，方向键/缩放键钉在底部永不被挤 */
.cmp.one{grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin-top:6px}
.cmp.one .cell{padding:3px 6px;border-radius:8px}
.cmp.one .lbl{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cmp.one .val{font-size:12.5px;margin-top:0;letter-spacing:-.3px;white-space:nowrap}
.cmp.one .val small{display:none}
.res{flex:0 1 auto;min-height:0;overflow:hidden}
.res .note{display:flex;gap:6px;justify-content:space-between;font-size:9.5px;color:var(--muted);
  margin-top:3px;white-space:nowrap;overflow:hidden}
.res .note>span{overflow:hidden;text-overflow:ellipsis}
.side .panel .dpad,.side .panel .sizepad{flex:0 0 auto}
.verdict{margin-top:11px;padding:10px 14px;border-radius:11px;font-size:13px;font-weight:600;
  display:none;align-items:center;gap:8px;line-height:1.5}
.verdict.show{display:flex}
.verdict.good{background:rgba(46,204,113,.1);border:1px solid rgba(46,204,113,.4);color:var(--ok)}
.verdict.bad{background:rgba(255,93,93,.1);border:1px solid rgba(255,93,93,.45);color:var(--danger)}
.verdict.mute{background:var(--panel2);border:1px solid var(--border);color:var(--muted)}
.small{font-size:11px;color:var(--muted);line-height:1.6}

/* ===== 炫酷增强 ===== */
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(600px 420px at 12% 8%,rgba(79,140,255,.20),transparent 60%),
             radial-gradient(520px 400px at 88% 92%,rgba(124,92,255,.18),transparent 60%),
             radial-gradient(420px 320px at 82% 12%,rgba(46,204,113,.10),transparent 60%)}
#app{position:relative;z-index:1}
.panel,.side details{backdrop-filter:blur(14px);background:rgba(18,26,46,.72)}
.panel{transition:border-color .25s,box-shadow .25s}
.panel:hover{border-color:rgba(79,140,255,.35);box-shadow:0 6px 24px rgba(0,0,0,.4),0 0 0 1px rgba(79,140,255,.08)}
button.act.primary{position:relative;overflow:hidden}
button.act.primary::after{content:'';position:absolute;inset:0;
  background:linear-gradient(110deg,transparent 32%,rgba(255,255,255,.38) 50%,transparent 68%);
  transform:translateX(-100%);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{0%,55%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
.pill.ok .dot,.pill.busy .dot{animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.9)}}
.cmp .val{background:linear-gradient(135deg,#ffffff,#9fc2ff);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;font-size:15px;font-variant-numeric:tabular-nums}
.main::after{content:none}
header .t{background:linear-gradient(135deg,#fff 35%,#8ab4ff);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent}
.logo{animation:logoGlow 3s ease-in-out infinite alternate}
@keyframes logoGlow{from{box-shadow:0 0 10px rgba(79,140,255,.4)}to{box-shadow:0 0 20px rgba(124,92,255,.65)}}
/* 加载转圈 */
.spinner{position:absolute;top:50%;left:50%;width:52px;height:52px;margin:-26px 0 0 -26px;
  border:4px solid rgba(79,140,255,.18);border-top-color:var(--accent);border-radius:50%;
  animation:spin .8s linear infinite;display:none;pointer-events:none;z-index:6}
.spinner.show{display:block}
@keyframes spin{to{transform:rotate(360deg)}}
.main .spinner{box-shadow:0 0 24px rgba(79,140,255,.35)}
/* ===== 设置页 ===== */
#settingsMask{position:fixed;inset:0;background:rgba(3,6,14,.75);display:none;z-index:40}
#settingsMask.show{display:block}
.sheet{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(600px,94vw);max-height:90vh;
  display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--border);border-radius:14px;
  box-shadow:0 18px 50px rgba(0,0,0,.65)}
.sheet .head{display:flex;align-items:center;justify-content:space-between;padding:9px 14px;
  border-bottom:1px solid var(--border);font-size:13px;font-weight:700}
.sheet .sc{overflow:auto;padding:10px 14px;display:flex;flex-direction:column;gap:9px}
.sheet .foot{display:flex;gap:8px;justify-content:flex-end;padding:9px 14px;border-top:1px solid var(--border)}
.sheet label.row{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted)}
.sheet input,.sheet textarea{width:100%;background:var(--panel2);border:1px solid var(--border);border-radius:8px;
  color:var(--fg);font-size:12px;padding:5px 8px;font-family:Consolas,monospace}
.sheet textarea{resize:vertical;min-height:40px}
.sheet input[type=checkbox]{width:auto}
.sheet .sec{font-size:11px;font-weight:700;color:var(--accent);letter-spacing:1px;margin-top:3px}
.sheet .tr{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:11.5px;color:var(--muted)}
.sheet .bt{cursor:pointer;border:1px solid var(--border);background:var(--panel2);color:var(--fg);
  border-radius:8px;padding:6px 13px;font-size:12px}
.sheet .bt.pri{background:var(--accent);border-color:transparent;color:#fff;font-weight:700}
.sheet details summary{font-size:11.5px;color:var(--muted);cursor:pointer;padding:3px 0;user-select:none}
#stOut{font-family:Consolas,monospace;font-size:11.5px;line-height:1.65;white-space:pre-wrap;
  background:rgba(0,0,0,.3);border:1px solid var(--border);border-radius:8px;padding:7px 9px;min-height:32px}
#setTestOut.ok,#setRtspOut.ok{color:#22c55e}#setTestOut.bad,#setRtspOut.bad{color:#ff5d5d}
/* 校准期间全局锁定 */
#lockMask{position:fixed;inset:0;display:none;z-index:38;background:rgba(3,6,14,.58);
  align-items:center;justify-content:center}
#lockMask.show{display:flex}
#lockMask .box{background:var(--panel);border:1px solid var(--border);border-radius:14px;
  padding:16px 28px;font-size:14px;font-weight:700;box-shadow:0 12px 40px rgba(0,0,0,.6)}
/* 十字方向键（小按钮） + 圆大小按钮 */
.dpad{display:grid;grid-template-columns:repeat(3,46px);grid-template-rows:repeat(3,46px);
  grid-template-areas:". up ." "left . right" ". down .";gap:4px;justify-content:center;margin-top:auto}
.dpad .nav{height:46px;border-radius:9px;border:1px solid var(--border);background:var(--panel2);
  color:var(--fg);font-size:20px;font-weight:700;cursor:pointer;transition:.14s;padding:0;
  touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.dpad .nav:active{transform:scale(.88);background:var(--panel)}
#mvUp{grid-area:up}#mvLeft{grid-area:left}#mvRight{grid-area:right}#mvDown{grid-area:down}
.sizepad{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px}
.sizepad .nav{height:40px;border-radius:9px;border:1px solid var(--border);background:var(--panel2);
  color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;transition:.14s;
  touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.sizepad .nav:active{transform:scale(.94);background:var(--panel)}
/* 颜色图例 */
.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:10.5px;color:var(--muted);margin-left:auto;white-space:nowrap}
.legend .lg{display:inline-flex;align-items:center;gap:5px}
.legend .lg i{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}
</style>
<script src="config.js"></script>
</head>
<body>
<div id="app">
  <header>
    <div class="logo">校</div>
    <div class="t">吊舱↔双目 对比验证<small>Gimbal ↔ Stereo Calibration Check</small></div>
    <div class="sp"></div>
    <span class="pill" id="pill"><span class="dot"></span><span id="stat">未取帧</span></span>
  </header>

  <div class="toolbar">
    <button class="act primary" id="fetchFrame">📷 获取帧</button>
    <button class="act" id="grabStereo">👁 获取双目</button>
    <button class="act" id="detect">⭕ 检测圆</button>
    <button class="act" id="calibrate">🎯 校准</button>
    <button class="act ghost" id="undo">撤销</button>
    <button class="act ghost" id="clear">清空</button>
    <button class="act ghost" id="btnSettings" title="设置">⚙️</button>
    <div class="legend">
      <span class="lg"><i style="background:#22c55e"></i>计算用</span>
      <span class="lg"><i style="background:#ff5d5d"></i>已剔除</span>
      <span class="lg"><i style="background:#ffc400"></i>选中</span>
    </div>
  </div>

  <div class="body">
    <div class="main" id="mainBox">
      <canvas id="cv"></canvas>
      <div class="spinner" id="spinner"></div>
      <div class="hintbar" id="hint">点「获取帧」拉取吊舱帧，点孔标注（自动吸附），点圆选中后按钮微调</div>
    </div>
    <div class="side">
  <div class="panel">
    <h3>计算结果 · 四孔中心（mm）</h3>
    <div class="res">
      <div class="cmp one">
        <div class="cell"><div class="lbl">吊舱dx</div><div class="val" id="vgdx">—<small>mm</small></div></div>
        <div class="cell"><div class="lbl">吊舱dy</div><div class="val" id="vgdy">—<small>mm</small></div></div>
        <div class="cell real"><div class="lbl">双目dx</div><div class="val real" id="vsdx">—<small>mm</small></div></div>
        <div class="cell real"><div class="lbl">双目dy</div><div class="val real" id="vsdy">—<small>mm</small></div></div>
      </div>
      <div class="note"><span id="curCam">当前帧：吊舱 1280×720</span><span>板心 <b id="vscenter">—</b></span></div>
    </div>
    <div class="dpad">
      <button class="nav" id="mvUp">↑</button>
      <button class="nav" id="mvLeft">←</button>
      <button class="nav" id="mvRight">→</button>
      <button class="nav" id="mvDown">↓</button>
    </div>
    <div class="sizepad">
      <button class="nav" id="shrink">缩小圆</button>
      <button class="nav" id="enlarge">放大圆</button>
    </div>
  </div>

    </div>
  </div>
</div>

<!-- ===== 设置页 ===== -->
<div id="settingsMask">
  <div class="sheet">
    <div class="head"><span>⚙️ 设置</span><button class="bt" id="setClose">关闭</button></div>
    <div class="sc">
      <div class="sec">网络</div>
      <label class="row">MQTT broker（可填多个，逗号分隔，连上哪个用哪个）
        <textarea id="setBroker" rows="2" placeholder="tcp://192.168.3.78:1883,tcp://192.168.2.82:1883"></textarea>
      </label>
      <div class="tr">
        <button class="bt" id="setTestBroker">测试 broker</button>
        <span id="setTestOut">—</span>
        <span id="setLiveConn" style="margin-left:auto">当前连接：—</span>
      </div>
      <label class="row">吊舱 RTSP<input id="setRtsp" placeholder="rtsp://192.168.144.25:8554/main.264" /></label>
      <div class="tr"><button class="bt" id="setTestRtsp">测试 RTSP</button><span id="setRtspOut">—</span></div>

      <div class="sec">标定</div>
      <label class="row">scale（mm/px，吊舱）<input id="setScale" type="number" step="0.001" /></label>
      <div class="tr"><span style="color:var(--muted)">双目 scale：<b id="stereoScaleVal">0.830</b> mm/px（1536×1280；零位同帧标定 2026-11-06：深度图 900.7mm÷fx1081.76=0.8326 与板尺互验 0.8235，差 1.1%。旧 0.680 作废）</span></div>
      <div class="tr"><span id="setRef">—</span><button class="bt" id="setResetRef">复位参考点</button></div>
      <div class="tr"><span id="stRef">—</span></div>
      <div class="tr" style="font-size:11px;color:var(--muted);line-height:1.6">换算依据：吊舱与双目在零位同帧实测，<b>毫米层面 1:1 相等</b>（归零后双目 0.0±0.6mm、吊舱 0.0±1.9mm）⇒ 吊舱的 dx/dy 就是双目的 dx/dy。双目 scale 只用来反推「板心应出现在双目画面哪个像素」便于比对。两套常量各按各的帧分辨率标定，<b>不可共用</b>；点「校准」在现场零位重采会覆盖当前帧来源那套的默认值。</div>

      <details>
        <summary>高级：MQTT 话题与客户端（一般不用改）</summary>
        <label class="row">真值订阅 subscribe<input id="setSub" /></label>
        <label class="row">结果发布 publish<input id="setPub" /></label>
        <label class="row">校准命令 calibCmd<input id="setCalibCmd" /></label>
        <label class="row">校准状态 calibStatus<input id="setCalibStatus" /></label>
        <label class="row">双目请求 stereoGrab<input id="setSgrab" /></label>
        <label class="row">双目返回 stereoImage<input id="setSimage" /></label>
        <label class="row">clientId<input id="setClientId" /></label>
        <label class="row">MQTT 开关<input id="setMqttOn" type="checkbox" /></label>
      </details>

      <div class="sec">功能自测</div>
      <div class="tr">
        <button class="bt" id="setSelfTest">开始自测</button>
        <button class="bt" id="setReset">恢复出厂默认</button>
      </div>
      <div id="stOut">点「开始自测」逐项检查：配置格式 → MQTT 连接 → 双目取帧往返 → 真值/校准话题 → 画面与存储</div>
    </div>
    <div class="foot"><button class="bt pri" id="setSave">保存并应用</button></div>
  </div>
</div>

<!-- ===== 校准锁定遮罩 ===== -->
<div id="lockMask"><div class="box" id="lockText">⏳ 校准中，请稍候…</div></div>

<script>
'use strict';
/* ================= 吸附（holesnap 算法） ================= */
const DEFAULTS={windowR:160,minArea:80,searchR:40};
function clamp(v,lo,hi){return v<lo?lo:(v>hi?hi:v)}
function otsu(hist,total){let sum=0;for(let i=0;i<256;i++)sum+=i*hist[i];
  let bg=0,mb=0,bestV=-1,bestT=127;
  for(let i=0;i<256;i++){bg+=hist[i];if(bg===0)continue;const fg=total-bg;if(fg===0)break;
    mb+=i*hist[i];const mbAvg=mb/bg,mfAvg=(sum-mb)/fg;const v=bg*fg*(mbAvg-mfAvg)*(mbAvg-mfAvg);
    if(v>bestV){bestV=v;bestT=i}}return bestT}
function snapImageData(id,u,v,opts){const o=Object.assign({},DEFAULTS,opts||{});
  const W=id.width,H=id.height,data=id.data;
  const x0=clamp(Math.floor(u-o.windowR),0,W-1),y0=clamp(Math.floor(v-o.windowR),0,H-1);
  const x1=clamp(Math.ceil(u+o.windowR),0,W-1),y1=clamp(Math.ceil(v+o.windowR),0,H-1);
  const w=x1-x0+1,h=y1-y0+1;if(w<=0||h<=0)return null;
  const lum=new Uint8Array(w*h),hist=new Uint32Array(256);
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){const si=((y0+y)*W+(x0+x))*4;
    const g=(data[si]*299+data[si+1]*587+data[si+2]*114)/1000|0;lum[y*w+x]=g;hist[g]++}
  const t=otsu(hist,w*h);
  let sx=clamp(Math.round(u-x0),0,w-1),sy=clamp(Math.round(v-y0),0,h-1);
  if(lum[sy*w+sx]>t){let found=false;
    for(let r=1;r<=o.searchR&&!found;r++)for(let dy=-r;dy<=r&&!found;dy++)for(let dx=-r;dx<=r;dx++){
      const nx=sx+dx,ny=sy+dy;if(nx<0||ny<0||nx>=w||ny>=h)continue;
      if(lum[ny*w+nx]<=t){sx=nx;sy=ny;found=true;break}}
    if(!found)return null}
  const seen=new Uint8Array(w*h),stack=[sy*w+sx];seen[sy*w+sx]=1;let n=0,sumx=0,sumy=0;
  while(stack.length){const idx=stack.pop();if(lum[idx]>t)continue;
    const cx=idx%w,cy=(idx/w)|0;n++;sumx+=cx;sumy+=cy;
    if(cx>0&&!seen[idx-1]){seen[idx-1]=1;stack.push(idx-1)}
    if(cx<w-1&&!seen[idx+1]){seen[idx+1]=1;stack.push(idx+1)}
    if(cy>0&&!seen[idx-w]){seen[idx-w]=1;stack.push(idx-w)}
    if(cy<h-1&&!seen[idx+w]){seen[idx+w]=1;stack.push(idx+w)}}
  if(n<o.minArea)return null;
  return{cx:x0+sumx/n,cy:y0+sumy/n,r:Math.sqrt(n/Math.PI),area:n}}

/* ============ RANSAC 鲁棒质心：挑最像矩形的 4 个点，剔除误点的圆 ============ */
function parallelogramResidual(p){const cx=(p[0].x+p[1].x+p[2].x+p[3].x)/4,cy=(p[0].y+p[1].y+p[2].y+p[3].y)/4;
  const q=p.slice().sort((a,b)=>Math.atan2(a.y-cy,a.x-cx)-Math.atan2(b.y-cy,b.x-cx));
  return Math.hypot((q[0].x+q[2].x-q[1].x-q[3].x)/2,(q[0].y+q[2].y-q[1].y-q[3].y)/2)}
function enumerate4(n){const out=[];
  if(n<=12){for(let a=0;a<n-3;a++)for(let b=a+1;b<n-2;b++)for(let c=b+1;c<n-1;c++)for(let d=c+1;d<n;d++)out.push([a,b,c,d])}
  else{const seen=new Set();for(let t=0;t<2000;t++){const i=[];while(i.length<4){const r=Math.floor(Math.random()*n);if(!i.includes(r))i.push(r)}i.sort((a,b)=>a-b);const k=i.join(',');if(!seen.has(k)){seen.add(k);out.push(i)}}}
  return out}
function robustCentroid(pts){const n=pts.length;if(n<4)return null;
  if(n===4){const cx=pts.reduce((s,p)=>s+p.x,0)/4,cy=pts.reduce((s,p)=>s+p.y,0)/4;return{cx,cy,inliers:[0,1,2,3]}}
  let best=Infinity,bi=null;
  for(const idx of enumerate4(n)){const res=parallelogramResidual(idx.map(i=>pts[i]));if(res<best){best=res;bi=idx}}
  if(!bi)return null;
  const cx=bi.reduce((s,i)=>s+pts[i].x,0)/4,cy=bi.reduce((s,i)=>s+pts[i].y,0)/4;
  return{cx,cy,inliers:bi}}

/* ============ 自动检测圆（迁移板端"外接矩形法"：Otsu + 连通域 + 圆度） ============ */
function detectCircles(){
  if(!off.width)return[];
  const id=octx.getImageData(0,0,off.width,off.height);
  const W=id.width,H=id.height,data=id.data,N=W*H;
  const gray=new Uint8Array(N),hist=new Uint32Array(256);
  for(let i=0;i<N;i++){const g=(data[i*4]*299+data[i*4+1]*587+data[i*4+2]*114)/1000|0;gray[i]=g;hist[g]++}
  const t=otsu(hist,N);
  let dark=0;for(let i=0;i<N;i++)if(gray[i]<t)dark++;
  const invert=dark>N*0.5;                       // 暗背景→找亮孔（黑帽场景的近似）
  const isHole=invert?(g)=>g>=t:(g)=>g<t;
  const seen=new Uint8Array(N),comps=[];
  for(let i=0;i<N;i++){
    if(seen[i]||!isHole(gray[i]))continue;
    const stack=[i];seen[i]=1;let area=0,sumx=0,sumy=0,minx=W,maxx=0,miny=H,maxy=0;
    while(stack.length){const p=stack.pop();area++;
      const x=p%W,y=(p/W)|0;sumx+=x;sumy+=y;
      if(x<minx)minx=x;if(x>maxx)maxx=x;if(y<miny)miny=y;if(y>maxy)maxy=y;
      if(x>0&&!seen[p-1]&&isHole(gray[p-1])){seen[p-1]=1;stack.push(p-1)}
      if(x<W-1&&!seen[p+1]&&isHole(gray[p+1])){seen[p+1]=1;stack.push(p+1)}
      if(y>0&&!seen[p-W]&&isHole(gray[p-W])){seen[p-W]=1;stack.push(p-W)}
      if(y<H-1&&!seen[p+W]&&isHole(gray[p+W])){seen[p+W]=1;stack.push(p+W)}}
    const bw=maxx-minx+1,bh=maxy-miny+1;
    if(Math.min(bw,bh)/Math.max(bw,bh)>0.5 && area/(bw*bh)>0.4 && area>60)
      comps.push({cx:sumx/area,cy:sumy/area,r:(bw+bh)/4,area});
  }
  comps.sort((a,b)=>b.area-a.area);
  return comps.slice(0,4);
}
function autoDetect(){
  const c=detectCircles();
  if(!c.length){document.getElementById('hint').textContent='未检测到圆，可手动点孔';return}
  marks=c.map(m=>({cx:m.cx,cy:m.cy,r:m.r,snapped:true,auto:true}));selected=-1;
  draw();recompute();
  document.getElementById('hint').textContent='检测到 '+c.length+' 个圆，点圆选中后用按钮微调';
}

