}
/* 校准：记下当前四孔中心为参考点 + 发布 cmd=calibrate 到 aruco/stop 给板端 */
function calibrate(){
  if(calibState === 1){ document.getElementById('hint').textContent='校准中，请稍候'; return; }
  // 人工补标模式：回传标注点（aruco/manual），不是发自动校准命令（aruco/stop）
  if(manualPending){
    if(inlierIdx.length < 4){
      document.getElementById('hint').textContent='未标满 4 个孔，无法回传';
      return;
    }
    // 坐标还原：双目帧被降采样到 1280 宽显示，板端要 1536×1280 原图坐标
    const OW = 1536, OH = 1280;
    const sx = img.width>0 ? OW/img.width : 1;
    const sy = img.height>0 ? OH/img.height : 1;
    const points = inlierIdx.map(i=>({
      x: Math.round(marks[i].cx*sx*10)/10,
      y: Math.round(marks[i].cy*sy*10)/10,
      r: Math.round((marks[i].r||0)*sx)
    }));
    const mcfg=(window.GIMBAL_CONFIG||{}).mqtt;
    if(mcfg && mcfg.manualResp) mqttPublish(mcfg.manualResp, JSON.stringify({image_id: manualPending.image_id||'', points: points}));
    document.getElementById('hint').textContent='已回传人工标注（'+points.length+' 孔）';
    setStat('已回传人工标注','ok');
    manualPending = null;
    const btn=document.getElementById('calibrate');
    if(btn){btn.textContent='🎯 校准';}
    recompute();
    return;
  }
  if(inlierIdx.length < 4){
    document.getElementById('hint').textContent='未标满 4 个孔，无法校准';
    return;
  }
  if(lastDx == null || lastDy == null){
    document.getElementById('hint').textContent='dx/dy 未计算，请先标注四孔再校准';
    return;
  }
  const pts = inlierIdx.map(i=>marks[i]);
  const cx = pts.reduce((s,m)=>s+m.cx,0)/4;
  const cy = pts.reduce((s,m)=>s+m.cy,0)/4;
  // 校准写的是「当前帧来源」那套常量（吊舱帧→吊舱基准，双目帧→双目基准），分开存
  if(frameSrc==='stereo'){ ST_REF_X=cx; ST_REF_Y=cy; stCalibrated=true;
    try{ localStorage.setItem('stereo_ref', JSON.stringify({x:cx, y:cy})); }catch(e){} }
  else { REF_X=cx; REF_Y=cy; calibrated=true;
    try{ localStorage.setItem('gimbal_ref', JSON.stringify({x:cx, y:cy})); }catch(e){} }
  if(frameSrc==='stereo'){
    // 双目基准是 App 本地量，不通知板端、不锁 UI（板端 calibrate 会动平台，危险）
    document.getElementById('hint').textContent='双目基准已就地保存 ('+cx.toFixed(1)+','+cy.toFixed(1)+') px —— 本地生效，未通知板端';
    recompute(); return;
  }
  // 发送校准命令给板端（发布到 aruco/stop）
  const mcfg=(window.GIMBAL_CONFIG||{}).mqtt;
  if(mcfg && mcfg.calibCmd) mqttPublish(mcfg.calibCmd, JSON.stringify({cmd:"calibrate"}));
  updateCalibButton(1);  // 立即置「校准中」禁点
  lockUIFor(60000, '⏳ 校准中，请稍候…');   // 校准期间全局锁定，收到完成/失败状态或 60s 超时解锁
  document.getElementById('hint').textContent='已校准，参考点 ('+cx.toFixed(1)+','+cy.toFixed(1)+')';
  recompute();
}

/* ================= 初始化 ================= */
function applyConfig(){
  const CFG = (typeof window!=='undefined' && window.GIMBAL_CONFIG) || {};
  DEFAULT_FRAME_URL = CFG.frameUrl || URL_FALLBACK;
  DEFAULT_RTSP = CFG.rtspUrl || '';
  if(CFG.gimbalRefX!=null)REF_X=CFG.gimbalRefX;
  if(CFG.gimbalRefY!=null)REF_Y=CFG.gimbalRefY;
  if(CFG.scale!=null)SCALE=CFG.scale;
  if(CFG.stereoRefX!=null)ST_REF_X=CFG.stereoRefX;
  if(CFG.stereoRefY!=null)ST_REF_Y=CFG.stereoRefY;
  if(CFG.stereoScale!=null)ST_SCALE=CFG.stereoScale;
  // 恢复已保存的校准参考点（吊舱 / 双目 分开）
  try{
    const s=localStorage.getItem('gimbal_ref');
    if(s){const o=JSON.parse(s);if(o.x!=null&&o.y!=null){REF_X=o.x;REF_Y=o.y;calibrated=true;}}
    const t=localStorage.getItem('stereo_ref');
    if(t){const o=JSON.parse(t);if(o.x!=null&&o.y!=null){ST_REF_X=o.x;ST_REF_Y=o.y;stCalibrated=true;}}
  }catch(e){}
  recompute();
  try{ window.__takeManual && window.__takeManual(); }catch(e){}   // 冷启动：取走服务暂存的标注请求
}
/* 现场免重打包：HBuilder 运行时读 /sdcard/gimbal_config.json 覆盖内置配置 */
function loadExternalConfig(){
  if(typeof plus==='undefined'||!plus.io) return;
  const paths=['/sdcard/gimbal_config.json','_doc/gimbal_config.json'];
  let i=0;
  (function tryNext(){
    if(i>=paths.length) return;
    const p=paths[i++];
    plus.io.resolveLocalFileSystemURL(p, function(entry){
      entry.file(function(file){
        const r=new plus.io.FileReader();
        r.onloadend=function(e){
          try{
            const ext=JSON.parse(e.target.result);
            if(ext && typeof ext==='object'){
              window.GIMBAL_CONFIG = Object.assign({}, window.GIMBAL_CONFIG||{}, ext);
              applyConfig();
            }
          }catch(err){ /* 解析失败，沿用内置配置 */ }
        };
        r.readAsText(file, 'utf-8');
      }, tryNext);
    }, tryNext);
  })();
}
/* ================= 设置页 ================= */
const SETTINGS_KEY='gimbal_settings_v1';
const SET_FIELDS=[
  ['setBroker','mqtt.broker'],['setRtsp','rtspUrl'],['setScale','scale'],
  ['setSub','mqtt.subscribe'],['setPub','mqtt.publish'],
  ['setCalibCmd','mqtt.calibCmd'],['setCalibStatus','mqtt.calibStatus'],
  ['setSgrab','mqtt.stereoGrab'],['setSimage','mqtt.stereoImage'],
  ['setClientId','mqtt.clientId']
];
function cfgGet(path){ return path.split('.').reduce((o,k)=>(o==null?undefined:o[k]), window.GIMBAL_CONFIG||{}); }
function cfgSet(path,v){ const ks=path.split('.'); let o=window.GIMBAL_CONFIG||(window.GIMBAL_CONFIG={});
  for(let i=0;i<ks.length-1;i++){ o[ks[i]]=o[ks[i]]||{}; o=o[ks[i]]; } o[ks[ks.length-1]]=v; }
function cfgMerge(base,over){ const out=Object.assign({},base||{});
  Object.keys(over||{}).forEach(k=>{ const v=over[k];
    if(v&&typeof v==='object'&&!Array.isArray(v)&&base&&typeof base[k]==='object') out[k]=cfgMerge(base[k],v);
    else out[k]=v; });
  return out; }
function loadSettings(){
  try{ const raw=localStorage.getItem(SETTINGS_KEY); if(!raw) return;
    const o=JSON.parse(raw); if(o&&typeof o==='object') window.GIMBAL_CONFIG=cfgMerge(window.GIMBAL_CONFIG,o);
  }catch(e){}
}
function openSettings(){
  SET_FIELDS.forEach(([id,p])=>{ const el=document.getElementById(id); if(el) el.value=(cfgGet(p)!=null?cfgGet(p):''); });
  const on=document.getElementById('setMqttOn'); if(on) on.checked=!!cfgGet('mqtt.enabled');
  const ref=document.getElementById('setRef');
  if(ref) ref.textContent='吊舱参考点 ('+Number(REF_X).toFixed(1)+', '+Number(REF_Y).toFixed(1)+')'+(calibrated?'（已校准）':'（默认）')+' · scale '+Number(SCALE).toFixed(3)+' mm/px';
  const sr=document.getElementById('stRef');
  if(sr) sr.textContent='双目参考点 ('+Number(ST_REF_X).toFixed(1)+', '+Number(ST_REF_Y).toFixed(1)+')'+(stCalibrated?'（已校准）':'（默认）')+' · scale '+Number(ST_SCALE).toFixed(3)+' mm/px';
  const ps=document.getElementById('podScaleVal'); if(ps) ps.textContent=Number(SCALE).toFixed(3);
  const sv=document.getElementById('stereoScaleVal'); if(sv) sv.textContent=Number(ST_SCALE).toFixed(3);
  try{ refreshLiveConn(); }catch(e){}
  document.getElementById('settingsMask').classList.add('show');
}
function closeSettings(){ document.getElementById('settingsMask').classList.remove('show'); }
function saveSettings(){
  SET_FIELDS.forEach(([id,p])=>{ const el=document.getElementById(id); if(!el) return;
    let v=el.value.trim(); if(p==='scale') v=Number(v)||0; cfgSet(p,v); });
  const on=document.getElementById('setMqttOn'); if(on) cfgSet('mqtt.enabled', !!on.checked);
  try{ localStorage.setItem(SETTINGS_KEY, JSON.stringify(window.GIMBAL_CONFIG)); }catch(e){}
  applyConfig(); startMqttFromConfig(); closeSettings();
  document.getElementById('hint').textContent='设置已保存并应用';
}
function resetSettings(){
  if(!confirm('恢复出厂默认？当前设置会被清除。')) return;
  try{ localStorage.removeItem(SETTINGS_KEY); }catch(e){}
  location.reload();
}
function resetRefPoint(){
  try{ localStorage.removeItem('gimbal_ref'); localStorage.removeItem('stereo_ref'); }catch(e){}
  calibrated=false; stCalibrated=false;
  const CFG=(window.GIMBAL_CONFIG||{});
  if(CFG.gimbalRefX!=null)REF_X=CFG.gimbalRefX;
  if(CFG.gimbalRefY!=null)REF_Y=CFG.gimbalRefY;
  if(CFG.stereoRefX!=null)ST_REF_X=CFG.stereoRefX;
  if(CFG.stereoRefY!=null)ST_REF_Y=CFG.stereoRefY;
  recompute(); openSettings();
}
async function runSelfTest(){
  const out=document.getElementById('stOut'); const lines=[];
  const add=(name,st,detail)=>{ const ico=st===true?'✅':(st===false?'❌':'⚠️');
    lines.push(ico+' '+name+(detail?('：'+detail):'')); out.textContent=lines.join('\n'); };
  out.textContent='检查中…';
  const lm=window.__lastMsgAt||{};
  const broker=String(cfgGet('mqtt.broker')||'').trim();
  const list=broker.split(',').map(s=>s.trim()).filter(Boolean);
  const bad=list.filter(b=>!/^tcp:\/\/[^\s:,]+:\d+$/.test(b));
  add('配置·broker 格式', (list.length>0&&bad.length===0), bad.length?('非法 '+bad.join(' ')):(list.length+' 个候选'));
  const sc=Number(cfgGet('scale'));
  add('配置·scale', sc>0.01&&sc<10, sc+' mm/px');
  // 双相机常量 + mm 1:1 换算自检
  const ssc=Number(cfgGet('stereoScale')), srx=Number(cfgGet('stereoRefX')), sry=Number(cfgGet('stereoRefY'));
  add('双相机常量齐备', (sc>0.01&&sc<10&&ssc>0.01&&ssc<10&&srx>0&&sry>0),
      '吊舱 ('+REF_X.toFixed(1)+','+REF_Y.toFixed(1)+')/'+sc+' · 双目 ('+srx+','+sry+')/'+ssc);
  const tpx=Math.round(100/ssc);
  add('换算·100mm→双目像素', tpx>40&&tpx<400, '±100mm ↔ ±'+tpx+'px（两路 mm 1:1，双目按 k_st='+ssc+' 折像素）');
  const rtsp=String(cfgGet('rtspUrl')||'');
  add('配置·RTSP 地址', /^rtsp:\/\//.test(rtsp), rtsp||'(空)');
  let conn=false; try{ conn=!!(window.G20&&window.G20.mqttIsConnected&&window.G20.mqttIsConnected()); }catch(e){}
  add('MQTT 连接', conn, conn?'已连接':'未连接');
  if(conn){
    const imgTopic=cfgGet('mqtt.stereoImage')||'stereo/image';
    const grabTopic=cfgGet('mqtt.stereoGrab')||'stereo/grab';
    const before=lm[imgTopic]||0; const t0=Date.now();
    mqttPublish(grabTopic, JSON.stringify({cmd:'grab'}));
    let got=false;
    for(let i=0;i<40&&!got;i++){ await new Promise(r=>setTimeout(r,200)); got=(lm[imgTopic]||0)>before; }
    add('双目取帧往返', got, got?('耗时 '+(Date.now()-t0)+' ms'):'8 秒内未收到');
    const now=Date.now();
    const realT=String(cfgGet('mqtt.subscribe')||'').split(',').map(s=>s.trim()).filter(Boolean);
    const hitReal=realT.some(t=>now-(lm[t]||0)<10000);
    add('真值话题近期数据', hitReal?'warn':hitReal, realT.join(' | ')||'(未配置)');
    const csT=cfgGet('mqtt.calibStatus');
    const hitCs=csT&&(now-(lm[csT]||0)<60000);
    add('校准状态话题', hitCs?'warn':hitCs, csT||'(未配置)');
  } else {
    add('双目取帧往返', false, '未连接，跳过');
  }
  const hasImg=(typeof img!=='undefined')&&img&&img.width>0;
  add('画面已加载图像', hasImg?'warn':hasImg, hasImg?(img.width+'×'+img.height):'未取帧');
  let ls=false; try{ localStorage.setItem('__st','1'); localStorage.removeItem('__st'); ls=true; }catch(e){}
  add('本地存储可用', ls);
  const fail=lines.filter(l=>l.indexOf('❌')===0).length;
  out.textContent=lines.concat(['', fail?('共 '+fail+' 项失败'):'全部通过']).join('\n');
}
/* ---- 探测结果回调 + 全局锁定 ---- */
let __lockTimer=null;
function lockUI(on,text){
  const m=document.getElementById('lockMask'); if(!m) return;
  if(on){ const t=document.getElementById('lockText'); if(text&&t) t.textContent=text; m.classList.add('show'); }
  else { m.classList.remove('show'); clearTimeout(__lockTimer); __lockTimer=null; }
}
function lockUIFor(ms,text){
  lockUI(true,text); clearTimeout(__lockTimer);
  __lockTimer=setTimeout(()=>{ lockUI(false);
    const h=document.getElementById('hint'); if(h) h.textContent='校准超时，已解锁'; }, ms);
}
function refreshLiveConn(){
  const el=document.getElementById('setLiveConn'); if(!el) return;
  let conn=false; try{ conn=!!(window.G20&&window.G20.mqttIsConnected&&window.G20.mqttIsConnected()); }catch(e){}
  el.textContent='当前连接：'+(conn?'已连接':'未连接');
  el.style.color=conn?'#22c55e':'#ff5d5d';
}
window.onMqttProbeResult=function(ok,msg){
  const out=document.getElementById('setTestOut'); if(!out) return;
  out.textContent=(ok?'✅ ':'❌ ')+(msg||'');
  out.className=ok?'ok':'bad';
  refreshLiveConn();
};
window.onRtspProbeResult=function(ok,msg){
  const out=document.getElementById('setRtspOut'); if(!out) return;
  out.textContent=(ok?'✅ ':'❌ ')+(msg||'');
  out.className=ok?'ok':'bad';
};
(function bindSettings(){
  const on=(id,ev,fn)=>{ const el=document.getElementById(id); if(el) el.addEventListener(ev,fn); };
  on('btnSettings','click',openSettings);
  on('setClose','click',closeSettings);
  on('setSave','click',saveSettings);
  on('setReset','click',resetSettings);
  on('setResetRef','click',resetRefPoint);
  on('setSelfTest','click',runSelfTest);
  on('setTestBroker','click',()=>{
    const el=document.getElementById('setBroker');
    const val=(el?el.value:'').trim();
    const out=document.getElementById('setTestOut');
    if(!window.G20||!window.G20.mqttProbe){ out.className='bad'; out.textContent='当前包不支持测试'; return; }
    if(!val){ out.className='bad'; out.textContent='请先填写 broker'; return; }
    out.className=''; out.textContent='测试中…';
    window.G20.mqttProbe(val);
  });
  on('setTestRtsp','click',()=>{
    const el=document.getElementById('setRtsp');
    const val=(el?el.value:'').trim();
    const out=document.getElementById('setRtspOut');
    if(!window.G20||!window.G20.rtspProbe){ out.className='bad'; out.textContent='当前包不支持测试'; return; }
    if(!val){ out.className='bad'; out.textContent='请先填写地址'; return; }
    out.className=''; out.textContent='测试中…';
    window.G20.rtspProbe(val);
  });
  refreshLiveConn();
})();
loadSettings();
applyConfig();
startMqttFromConfig();
recompute();
loadExternalConfig();
/* 提示条：内容变化时短暂显示 3.5s 后自动淡出，避免长时间压住画面 */
(function(){
  const h=document.getElementById('hint'); if(!h) return;
  let t=null;
  const kick=()=>{ h.classList.add('show'); clearTimeout(t); t=setTimeout(()=>h.classList.remove('show'),3500); };
  new MutationObserver(kick).observe(h,{childList:true,characterData:true,subtree:true});
  kick();
})();
</script>
