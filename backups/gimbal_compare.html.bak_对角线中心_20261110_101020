/* ============ MQTT 桥（App 内 ENABLE_MQTT 编译才可用） ============ */
function startMqttFromConfig(){
  const m = (window.GIMBAL_CONFIG||{}).mqtt;
  if(!m || !m.enabled) return;
  if(window.G20 && window.G20.mqttStart){
    const topics = [m.subscribe, m.calibStatus, m.stereoImage].filter(Boolean).join(',');
    window.G20.mqttStart(m.broker||'', m.clientId||'g20', topics);
  }
}
window.onMqttMessage = function(topic, payload){
  try{ (window.__lastMsgAt = window.__lastMsgAt || {})[topic] = Date.now(); }catch(e){}
  const mcfg=(window.GIMBAL_CONFIG||{}).mqtt;
  // 双目图返回（stereo/image，订阅收）
  if(mcfg && mcfg.stereoImage && topic === mcfg.stereoImage){
    try{
      const o = JSON.parse(payload);
      const img = o.img || o.image || o.data;
      if(img){
        const url = img.startsWith('data:') ? img : 'data:image/jpeg;base64,' + img;
        frameSrc = 'stereo';
        loadCompareFrame(url);
      } else {
        spinner(false); setStat('取双目失败','');
        document.getElementById('hint').textContent='双目图返回为空';
      }
    }catch(e){
      spinner(false); setStat('取双目失败','');
      document.getElementById('hint').textContent='双目图解析失败';
    }
    return;
  }
  // 校准状态（aruco/calibrate/status，订阅收）
  if(mcfg && mcfg.calibStatus && topic === mcfg.calibStatus){
    try{
      const o = JSON.parse(payload);
      const names = ['未纠偏','纠偏中','纠偏完成'];
      if(o.status!=null){
        updateCalibButton(o.status);
        if(o.status===2 || o.status===0) lockUI(false);   // 完成或未纠偏：解除全局锁定
        document.getElementById('hint').textContent = '校准状态: ' + (names[o.status] || ('状态'+o.status));
      }
    }catch(e){}
    return;
  }
  // 人工标注请求（自动校准失败，板端请求人工标注；用户自己「获取双目」抓帧来标）
  if(mcfg && mcfg.manualReq && topic === mcfg.manualReq){
    try{ enterManualMode(JSON.parse(payload)); }catch(e){}
    return;
  }
  // 真值 dx/dy：支持逗号分隔的多个话题（gimbal/real_dxdy 或板端 aruco/detection）
  {
    const realTopics = String(mcfg && mcfg.subscribe || '').split(',').map(s=>s.trim()).filter(Boolean);
    if(realTopics.indexOf(topic) >= 0){
      let dx=null, dy=null, skipped=false;
      try{
        const o = JSON.parse(payload);
        if(o.valid === 0 || o.valid === false) skipped = true;   // aruco/detection 无效帧
        if(o.dx!=null && o.dy!=null){dx=o.dx;dy=o.dy}
        else if(Array.isArray(o) && o.length>=2){dx=Number(o[0]);dy=Number(o[1])}
      }catch(e){
        const parts = payload.split(/[\s,]+/).map(Number);
        if(parts.length>=2 && !isNaN(parts[0]) && !isNaN(parts[1])){dx=parts[0];dy=parts[1]}
      }
      if(!skipped && dx!=null && dy!=null){
        setRealDxdy(dx, dy);
        document.getElementById('hint').textContent = 'MQTT 真值: dx='+dx+'  dy='+dy;
      }
      return;
    }
  }
};
window.mqttPublish = function(topic, payload){
  if(window.G20 && window.G20.mqttPublish) window.G20.mqttPublish(topic, payload);
};
/* 校准按钮状态：0=未纠偏(可点) 1=纠偏中(禁点) 2=纠偏完成 */
function updateCalibButton(state){
